# Copiar a server/.env. Nunca guardar claves reales en git.
PORT=3001
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Solo necesario para /api/v1/invoices/emit (ARCA). Nunca usar en VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
AFIPSDK_ACCESS_TOKEN=
AFIP_CUIT=
# El servidor Express acepta certificado y clave en variables de entorno.
AFIP_CERT=
AFIP_KEY=

# Utilidades scripts/arca (homologación; no necesarias para iniciar Express).
AFIP_ENVIRONMENT=testing
AFIP_CERT_PATH=./certificados/certificado.crt
AFIP_KEY_PATH=./certificados/invotrack.key

# Secretos de Edge Functions: configurar en Supabase, no en el proceso Express.
# Arca.crt / Arca.key / Arca.CUIT (o AFIP_CERT / AFIP_KEY / AFIP_CUIT)
# OPENAI_API_KEY, GOOGLE_CLOUD_PROJECT_ID, GOOGLE_DOCUMENT_AI_LOCATION,
# GOOGLE_DOCUMENT_AI_PROCESSOR_ID, GOOGLE_CLOUD_API_KEY, RESEND_API_KEY, FROM_EMAIL
